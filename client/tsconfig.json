{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "types": ["vite/client", "react", "react-dom"],
    "noEmit": true
  },
  "include": ["src"]
}